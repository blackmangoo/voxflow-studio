# =============================================================================
# VOXFLOW STUDIO — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and populate with your real credentials.
# NEVER commit .env, client_secrets.json, token_drive.json, or browser_profiles/
# =============================================================================

# 1. Studio Admin & Webhook Authentication Key (Required to trigger live Flow/Playwright renders)
STUDIO_ADMIN_KEY=change-me-to-a-strong-32-char-secret-key

# 2. Public Demo Sandbox Mode (true = blocks unauthenticated visitors from running Playwright or TTS)
PUBLIC_DEMO_MODE=true

# 3. Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# 4. Gemini API & Rotating TTS Keys (comma-separated)
GEMINI_API_KEY=your_primary_gemini_api_key
GEMINI_TTS_KEYS=key_1,key_2,key_3,key_4,key_6,key_7,key_8,key_9

# 5. Google Drive Root Folder ID
DRIVE_ROOT_FOLDER_ID=1hP0Drmnq4GzM4IcxzU1ub_ar0T6KAGCa

# 6. Optional Notification Webhooks
WA_AGENT_TOKEN=
WA_USER_ID=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
